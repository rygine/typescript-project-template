# Copy to .env and adjust.
# Shapes and safe defaults only — never real secrets. This file is committed.

# Port the service listens on
PORT=3000

# Host interface the port is published on. Loopback keeps the service local;
# 0.0.0.0 exposes it on every interface, and Docker bypasses ufw when it does.
BIND_ADDR=127.0.0.1

# Bind address — 0.0.0.0 is required inside a container.
# Binding localhost binds the container's loopback and is unreachable from the host.
HOST=0.0.0.0

# error | warn | info | debug | trace
LOG_LEVEL=info

# Directory the service writes state to.
# Baked into the image at build time — changing it requires `docker compose up --build`.
DATA_DIR=/data
